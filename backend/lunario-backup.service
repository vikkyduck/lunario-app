[Unit]
Description=Лунарио — резервная копия базы, ключей и контента

[Service]
Type=oneshot
# тот же пользователь, что у сервиса (F02): копии, снятые от root, кабинет админа потом не смог бы убрать по сроку
User=lunario
Group=lunario
UMask=0077
WorkingDirectory=/opt/lunario-app
Environment=DATA_DIR=/opt/lunario-app/data
Environment=CONTENT_DIR=/opt/lunario-content
Environment=BACKUP_DIR=/opt/lunario-app-backups
# BACKUP_SECRET — пароль шифрования копий. Читает systemd своим парсером: значения в .env
# бывают с символами, которые sh принимает за перенаправление, поэтому cron с `. .env` тут не годится.
EnvironmentFile=-/opt/lunario-app/.env
ExecStart=/usr/bin/node /opt/lunario-app/backend/backup.mjs
