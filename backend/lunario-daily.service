[Unit]
Description=Лунарио — напоминания по функциям (карта дня, настроение, привычки, аскеза, лунный день, небо)

[Service]
Type=oneshot
# тот же пользователь, что у сервиса (F02): иначе ночная задача создаст файлы от root, и сервис их потом не перепишет
User=lunario
Group=lunario
UMask=0077
WorkingDirectory=/opt/lunario-app
Environment=CONTENT_DIR=/opt/lunario-content
EnvironmentFile=-/opt/lunario-app/.env
ExecStart=/usr/bin/node /opt/lunario-app/backend/send-daily.mjs
